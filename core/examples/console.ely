// Test unified logging: console.debug, info, warn, error, log
// and bare print

func main() {
    console.debug("debug message")
    console.info("info message")
    console.warn("warn message")
    console.error("error message")
    console.log("log message")

    // Bare print
    print("bare print")

    // With string values
    let name = "Elysium"
    console.info("Hello, ", name)
    print("Goodbye, ", name)
}
