// switch/case/then/else — human & LLM friendly branching
// Desugars into match/case internally — no pipeline changes needed.

func describe_score(score: Int) -> String {
    return switch score {
        case 100 then { "Perfect!" }
        case 90 then { "Excellent!" }
        case 80 then { "Great!" }
        case 70 then { "Good" }
        case 60 then { "Passing" }
        else { "Needs improvement" }
    }
}

func main() {
    let s1 = describe_score(100)
    print(s1)
    print("\n")

    // switch as a statement
    let x = 3
    switch x {
        case 1 then { print("one\n") }
        case 2 then { print("two\n") }
        case 3 then { print("three\n") }
        else { print("many\n") }
    }

    // with _ wildcard
    let y = 42
    switch y {
        case 0 then { print("zero\n") }
        case _ then { print("non-zero\n") }
    }

    // string patterns
    let name = "bob"
    switch name {
        case "alice" then { print("hi alice\n") }
        case "bob" then { print("hi bob\n") }
        else { print("hi stranger\n") }
    }
}
