/// Simple spec test to verify the test command works
func add(a: Int, b: Int) -> Int {
    a + b
}

spec "Calculator" {
    feat "adds two numbers" {
        let result = add(2, 3)
        expect result == 5
    }
    feat "adds negative numbers" {
        let result = add(-1, -2)
        expect result == -3
    }
    feat "returns Int" {
        let result = add(10, 20)
        expect result
    }
}
